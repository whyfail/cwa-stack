# 全栈项目根级环境变量（仅本地开发使用，已加入 .gitignore）。
# pnpm setup 可依据本文件生成本地 .env 并随机注入密码；生产环境必须显式提供，
# 且后端生产 profile 缺少密钥时会启动失败（fail closed），绝不复用本地生成值。

# MySQL（apps/api 的 compose 栈）
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_APP_PASSWORD=replace-with-strong-app-password
MYSQL_DATABASE=app

# 首个管理员引导密码（仅 local profile；至少 12 位）
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-admin-password

# Management 端口（基线 9090；如本机被本地代理等占用，改为 9091 并保持唯一）
MANAGEMENT_PORT=9090
